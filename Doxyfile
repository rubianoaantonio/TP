# Configuração do Doxygen para o Cine PDS
# Uso, na raiz do repositório: doxygen Doxyfile

PROJECT_NAME           = "Cine PDS"
PROJECT_BRIEF          = "Sistema de venda de ingressos de cinema - TP de PDS II (UFMG)"
OUTPUT_LANGUAGE        = Brazilian

INPUT                  = include src README.md
FILE_PATTERNS          = *.h *.cpp
RECURSIVE              = NO
USE_MDFILE_AS_MAINPAGE = README.md

OUTPUT_DIRECTORY       = docs/doxygen
GENERATE_HTML          = YES
GENERATE_LATEX         = NO

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = NO
